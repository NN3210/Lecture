+def latitude_departure():
+    """縦成分ΔX、横成分ΔYと、象限別の符号を示す。"""
+    fig, ax = canvas(5.2)
+    a = np.array([2.6, 1.05]); b = a+4.6*unit(62.5); foot = np.array([a[0], b[1]])
+    arrow(ax, a, a+[0, 3.35], GRAY, 1)
