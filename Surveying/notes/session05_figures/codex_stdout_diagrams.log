+        text(ax, *c, '180°', 14, ha='center')
+    box(ax, 5.35, 1.7, 6, 1.15, 'n 角形 = (n − 2) 個の三角形\n内角の和 = (n − 2) × 180°', fs=15)
+    for j, (n, s) in enumerate([(3, 180), (4, 360), (5, 540), (6, 720)]):
+        x = 5.7+j*1.55
