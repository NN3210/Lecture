+        leader(ax, mid, xy, f'$T_{{{"ABCD"[i]}{"BCDA"[i]}}}$ = {BEARINGS[i]}\n{DIST[i]} m', NAVY, 'center')
+    box(ax, 7.35, 3.55, 4.25, 1.05, '左回り → 内角は右回り交角\n一周して $T_{AB}$ に戻る', fs=13)
+    text(ax, 7.55, 2.55, 'A → B → C → D → A', 14)
