+        arrow(ax, p[i], p[i+1], NAVY, 1.7)
+        point(ax, p[i], 'ABCD'[i], offset=[(-.25, -.24), (.13, -.04), (.1, .22), (-.3, .05)][i])
+    text(ax, 4.0, 2.65, '縦：ΔX', 13, TEAL)
+    text(ax, 4.0, 2.15, '横：ΔY', 13, ORANGE)
+    text(ax, 4.0, 1.55, '出発点へ\nほぼ戻る', 12)
