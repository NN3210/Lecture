def scale_factor():
    fig, ax = plt.subplots(figsize=(12,3.4))
    fig.subplots_adjust(left=.115,right=.71,bottom=.23,top=.90)
    y=np.linspace(-180,180,1001)
    factor=lambda v: .9999*(1+np.asarray(v)**2/(2*6370**2))
    ax.plot(y,factor(y),color=NAVY,lw=2.2)
    ax.axhline(1,color=GRAY,ls='--',lw=1)
    for value in [-130,130]:
        ax.axvline(value,color=GRAY,ls='--',lw=1)
    for value in [-130,-90,0,90,130]:
        ax.plot(value,factor(value),'o',color=TEAL if abs(value)==90 else ORANGE,ms=4)
    ax.set(xlim=(-180,180),ylim=(.9998,1.0002),xticks=[-180,-130,-90,0,90,130,180],
           yticks=[.9998,.9999,1,1.0001,1.0002],xlabel='Y・・m・・,ylabel='邵ｮ蟆ｺ菫よ焚 m')
    ax.ticklabel_format(axis='y',style='plain',useOffset=False)
    ax.tick_params(labelsize=12)
    ax.grid(alpha=.12)
    ax.text(0,.99983,'驕ｩ逕ｨ遽・峇 ﾂｱ130 km',ha='center',fontsize=12,color=GRAY)
    fig.text(.74,.78,'Y = 0・・.9999',fontsize=14,color=NAVY)
    fig.text(.74,.61,'Y = ﾂｱ90 km・壺沿 1.0000',fontsize=12,color=TEAL)
    fig.text(.74,.44,'Y = ﾂｱ130 km・壺沿 1.0001',fontsize=12,color=ORANGE)
    fig.text(.74,.23,'R = 6370 km\n豕ｨ險倥・蟆乗焚隨ｬ4菴阪↓荳ｸ繧√◆蛟､縲・,fontsize=12,color=GRAY,linespacing=1.7)
    fig.text(.12,.94,'m = 0.9999(1 + Yﾂｲ/(2Rﾂｲ))',fontsize=14,color=NAVY)
    save(fig,'scale_factor')


