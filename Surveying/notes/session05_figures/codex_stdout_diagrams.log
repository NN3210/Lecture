+def inverse_quadrant4():
+    """同じ原点から4方向へ、北起算の長い弧も省略せずに描く。"""
+    fig, ax = canvas(5.3)
+    o = np.array([6, 2.9])
+    arrow(ax, [3.4, o[1]], [8.65, o[1]], GRAY, 1)
+    arrow(ax, [6, .75], [6, 4.85], GRAY, 1)
