def forward_calc():
    fig,ax=canvas(3.4)
    a=np.array([2.75,2.17])
    b=a+2.8*np.array([np.sin(np.deg2rad(120)),np.cos(np.deg2rad(120))])
    arrow(ax,.9,.35,.9,2.87,NAVY)
    arrow(ax,.9,.35,6.15,.35,NAVY)
