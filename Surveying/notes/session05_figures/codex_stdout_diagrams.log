+    ax.add_patch(Polygon([[7.65, 1.55], [8.15, 1.55], [8.15, 2.2], [7.65, 2.2]], facecolor=GRAY, alpha=.7))
+    leader(ax, (7.9, 1.9), (8.15, 2.75), '障害物：視通なし', GRAY)
