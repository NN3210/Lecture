+def interior_angle_sum():
+    """五角形を3個の三角形に分割する。"""
+    fig, ax = canvas()
+    p = np.array([[.65, .6], [3.2, .5], [4.35, 1.9], [2.7, 2.9], [.7, 2.5]])
+    ax.add_patch(Polygon(p, closed=True, fill=False, edgecolor=NAVY, lw=2))
+    for j in [2, 3]:
