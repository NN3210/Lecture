+def deflection_angle():
+    """前の測線の延長線から測る右偏・左偏。"""
+    fig, ax = canvas()
+    for cx, turn, color, title in [(2.5, 55, ORANGE, '右偏（+）'), (9, -55, TEAL, '左偏（−）')]:
