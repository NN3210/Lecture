+def closure_preview():
+    """表の増分を積み重ね、戻りと微小な閉合差を示す。"""
+    fig, ax = canvas()
+    p = np.vstack([EXAMPLE, END])[:, ::-1]
+    p = (p-[949.027, 1000])*.016+[1.05, .55]
+    for i in range(4):
+        corner = np.array([p[i, 0], p[i+1, 1]])
+        arrow(ax, p[i], corner, TEAL, 1.4)
