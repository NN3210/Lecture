+    text(ax, 3.3, .12, '閉合差は縮尺上では見えない', 12, GRAY)
+    box(ax, 6.0, .65, 5.55, 2.1, 'ΣΔX = +0.001 m\nΣΔY = 0.000 m（例題）\n閉じるはず → 残りが閉合差\n許容と配分は第6回（コンパス法則）', fs=14)
+    save(fig, 'closure_preview')
+
+
+def inverse_quadrant4():
