+        arc(ax, b, .65, 0, turn, color)
+        text(ax, cx+(.9 if turn > 0 else -1.5), 2.45, 'δ = +' if turn > 0 else 'δ = −', 14, color)
+        for p, lab in [(a, 'A'), (b, 'B'), (c, 'C')]:
