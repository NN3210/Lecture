+        draw()
+    for p in sources:
+        assert hashlib.sha256(p.read_bytes()).hexdigest() == hashes[str(p.relative_to(ROOT))]
+    result = {'入力ファイルSHA256': hashes,
+              '座標の約束': 'Xが上（北）、Yが右（東）、方向角は北から右回り',
+              '仕様の補足': [
