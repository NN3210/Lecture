+    text(ax, .65, 4.43, '座標測定', 16, 'white')
+    rows = ['器械点 X0, Y0', '後視　方向角 T0', 'HA（方向角）T', 'SD（斜距離）', 'VA（鉛直角）', '→ X, Y, Z']
+    # 日本語は指定日本語フォント、ASCII記号は等幅で見せる画面の概念図。
+    for i, s in enumerate(rows):
+        text(ax, .65, 3.88-i*.45, s, 13, 'white')
