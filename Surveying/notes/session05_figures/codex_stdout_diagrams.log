+#!/usr/bin/env python3
+"""第5回「トラバース測量 I」の12図をSVG・PNG（180 dpi）で再生成する。"""
+from pathlib import Path
+import hashlib
+import atexit
+import json
+import os
+import shutil
+import sys
+import unicodedata
+import warnings
